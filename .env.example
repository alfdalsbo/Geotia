GEOTIA_PASSCODE=geotia
AUTH_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-random-cron-secret

# Optional, but required for durable shared storage on Vercel.
# Any Neon/Postgres connection string works.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Google Maps Platform.
# Enable Maps JavaScript API and Street View Static API, restrict the public key
# by HTTP referrer, restrict the server key by IP or API scope where possible,
# and set low quotas plus billing budget alerts in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
SLOWGEO_MONTHLY_ROUND_CAP=40
SLOWGEO_POOL_TARGET_UNUSED=500
SLOWGEO_POOL_LOW_WATERMARK=100

# Nominatim geocoding fallback for manual round preview.
# Use a contactable app/user-agent string if this leaves local testing.
GEOTIA_NOMINATIM_USER_AGENT="GeotiaSlowGeo/0.1 (private SlowGeo archive)"
